{
    "manifest_version": 3,
    "name": "Laser Machine Monitor",
    "version": "1.0",
    "description": "Monitor laser machines and trigger actions.",
    "permissions": ["storage", "activeTab", "tabs", "scripting", "cookies"],
    "host_permissions": ["https://*.indiamart.com/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png"
        }
    },
    "icons": {
        "16": "icon16.png"
    }
}
